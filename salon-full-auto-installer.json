      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst encoded = String(body.content || '').replace(/\\s+/g, '');\nconst query = encoded ? Buffer.from(encoded, 'base64').toString('utf8') : '';\nif (!query.trim()) {\n  throw new Error('schema.sql is empty or missing from the template repository');\n}\nreturn [{ json: { query } }];"
